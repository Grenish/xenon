{
  "name": "xenon-cms",
  "version": "0.1.0",
  "description": "Lightweight, code-first, Next.js-native headless CMS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Grenish/xenon.git",
    "directory": "packages/xenon"
  },
  "homepage": "https://github.com/Grenish/xenon#readme",
  "bugs": "https://github.com/Grenish/xenon/issues",
  "type": "module",
  "bin": {
    "xenon": "./dist/cli.js"
  },
  "sideEffects": [
    "*.css",
    "./dist/client.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./pglite": {
      "types": "./dist/pglite.d.ts",
      "import": "./dist/pglite.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle.d.ts",
      "import": "./dist/drizzle.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./storage/local": {
      "types": "./dist/storage/local.d.ts",
      "import": "./dist/storage/local.js"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3.d.ts",
      "import": "./dist/storage/s3.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsup && bun run build:css",
    "dev": "rm -rf dist && tsup && bun run build:css && (tsup --watch & tailwindcss -i src/ui/styles/admin.css -o dist/styles.css --watch=always & wait)",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:css": "tailwindcss -i src/ui/styles/admin.css -o dist/styles.css --minify && cp -R src/ui/styles/fonts dist/fonts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@remixicon/react": "^4.9.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "image-size": "^2.1.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/cli": "4.3.5",
    "@types/bun": "^1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "tsup": "^9.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "next": ">=16.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "postgres": ">=3.4.0",
    "@electric-sql/pglite": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    },
    "@electric-sql/pglite": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
