{
  "name": "xenon-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "build": "bun run --filter xenon-cms build",
    "dev": "bun run --filter xenon-cms dev",
    "test": "bun run --filter xenon-cms test",
    "typecheck": "bun run --filter '*' typecheck",
    "playground": "bun run --filter playground dev",
    "web": "bun run --filter web dev",
    "dev:all": "bash scripts/dev-all.sh"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
