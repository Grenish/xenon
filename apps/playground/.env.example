# Optional: use a real PostgreSQL server instead of the embedded PGlite database in .xenon/
# DATABASE_URL=postgres://user:password@localhost:5432/xenon
# Required in production: signs admin sessions (generate with `openssl rand -base64 32`)
XENON_SECRET=
# Public base URL of the app. Setting it silences BetterAuth's "Base URL is not set" warning.
# Change the port if `next dev` runs somewhere else, or sign-in requests will be rejected.
XENON_URL=http://localhost:3000
# Optional: REST API key for scripts (Authorization: Bearer <key>)
# XENON_API_KEY=
